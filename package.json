{
  "name": "dual-codex-day",
  "version": "0.21.0",
  "private": true,
  "description": "A local-first Codex profile launcher and personal usage dashboard.",
  "author": "AdlinZ",
  "repository": "https://github.com/AdlinZ/dual-codex-day",
  "license": "MIT",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node ./scripts/codex-day.mjs --open",
    "desktop": "electron .",
    "desktop:screenshot": "node ./scripts/capture-electron.mjs",
    "build:brand": "electron ./scripts/build-brand-assets.cjs",
    "package:electron": "node ./scripts/package-electron.mjs --platform win32 --arch x64",
    "index": "node ./scripts/codex-day.mjs --once",
    "profiles": "node ./scripts/codex-profiles.mjs list",
    "profiles:doctor": "node ./scripts/codex-profiles.mjs doctor",
    "build:profiles": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-profiles-launcher.ps1",
    "build:css": "tailwindcss -i ./src/styles.css -o ./src/token-dashboard.css --minify",
    "build:demo": "node ./scripts/build-demo.mjs",
    "build:site": "node ./scripts/build-site.mjs",
    "demo": "node ./scripts/build-demo.mjs --open",
    "site:preview": "node ./scripts/serve-site.mjs",
    "build": "npm run build:demo && npm run build:css",
    "test:index": "node ./scripts/check-indexer.mjs",
    "test:usage": "node ./scripts/check-usage-analysis.mjs",
    "test:cc-switch": "node ./scripts/check-cc-switch-audit.mjs",
    "test:skills": "node ./scripts/check-skills.mjs",
    "test:plugins": "node ./scripts/check-plugins.mjs",
    "test:service": "node ./scripts/check-service.mjs",
    "test:pricing": "node ./scripts/check-pricing.mjs",
    "test:profiles": "node ./scripts/check-profiles.mjs",
    "test:profile-transfer": "node ./scripts/check-profile-transfer.mjs",
    "test:profile-recovery": "node ./scripts/check-profile-recovery.mjs",
    "test:profile-doctor": "node ./scripts/check-profile-doctor.mjs",
    "test:electron": "node ./scripts/check-electron.mjs",
    "test:site": "node ./scripts/check-site.mjs",
    "test:tray": "node ./scripts/check-tray.mjs",
    "test:container": "node ./scripts/check-container.mjs",
    "test": "node ./scripts/check-dashboard.js && npm run test:index && npm run test:usage && npm run test:cc-switch && npm run test:skills && npm run test:plugins && npm run test:service && npm run test:pricing && npm run test:profiles && npm run test:profile-transfer && npm run test:profile-recovery && npm run test:profile-doctor && npm run test:electron && npm run build:site && npm run test:site && npm run test:tray && npm run test:container"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.0.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "lucide": "^1.34.0",
    "smol-toml": "^1.8.0"
  }
}
